[Unit]
Description=Create an encrypted SentinelOps SQLite snapshot
After=sentinelops.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/sentinelops/current
ExecStart=/usr/local/sbin/sentinelops-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/sentinelops /var/lib/sentinelops
RestrictAddressFamilies=AF_UNIX
