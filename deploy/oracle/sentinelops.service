[Unit]
Description=SentinelOps security workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinelops
Group=sentinelops
WorkingDirectory=/opt/sentinelops/current
EnvironmentFile=/etc/sentinelops/app.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/sentinelops/current/.venv/bin/python -m uvicorn backend.app:create_app --factory --host 127.0.0.1 --port 8110 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sentinelops
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
