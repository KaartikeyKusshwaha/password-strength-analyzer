APP_ORIGIN=http://127.0.0.1:8110
# Add only exact public DNS names you operate or have written permission to assess.
SCAN_HOSTS=
# Optional: Groq account key. Never commit this file after copying to .env.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# DATA_DIR defaults to ./data. Keep the DB and encryption key private and backed up together.
